# Database Configuration
# For local development, install PostgreSQL and create a database
# Example: postgresql://username:password@localhost:5432/database_name
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/fabric_infinity

# Session Secret - Generate a random 32+ character string
# You can generate one with: openssl rand -base64 32
# Or use: [System.Web.Security.Membership]::GeneratePassword(32,4) in PowerShell
SESSION_SECRET=change-this-to-a-secure-random-32-character-string

# API Server Port
PORT=5000

# Optional: AI Features (Get free key from console.groq.com)
GROQ_API_KEY=

# Optional: Payment Gateway (Get from Razorpay dashboard)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email OTP via Brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Fabric_Infinity

# Frontend Environment (automatically used by Vite)
VITE_WHATSAPP_NUMBER=918530361444
