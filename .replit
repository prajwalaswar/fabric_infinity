modules = ["nodejs-20", "web"]

[deployment]
router = "application"
deploymentTarget = "autoscale"
build = ["pnpm", "run", "build"]
run = ["pnpm", "--filter", "@workspace/api-server", "run", "start"]

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Fabric Infinity API"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Fabric Infinity Storefront"

[[workflows.workflow]]
name = "Fabric Infinity API"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=8080 pnpm --filter @workspace/api-server run dev"
waitForPort = 8080

[[workflows.workflow]]
name = "Fabric Infinity Storefront"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=19802 BASE_PATH=/ pnpm --filter @workspace/fabric-infinity run dev"
waitForPort = 19802

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
VITE_WHATSAPP_NUMBER = "918530361444"
BREVO_SENDER_EMAIL = "prajwalaswar123@gmail.com"
BREVO_SENDER_NAME = "Fabric_Infinity"
